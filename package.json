{
  "name": "lens-extension-inspect",
  "version": "0.1.2",
  "description": "See every pod of a cluster as a box, and zoom into one to see its containers and their processes.",
  "license": "MIT",
  "author": "phorsmalahti <phorsmalahti@mirantis.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panuhorsmalahti/inspect.git"
  },
  "bugs": {
    "url": "https://github.com/panuhorsmalahti/inspect/issues"
  },
  "homepage": "https://github.com/panuhorsmalahti/inspect#readme",
  "keywords": [
    "lens-extension"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "lensExtension": {
    "icon": "assets/icon.svg",
    "banner": "assets/banner.svg"
  },
  "scripts": {
    "build": "lens-css-module-types src && lens-types-check && lens-package-build --entry-point ./src/index.ts",
    "clean": "rimraf dist/"
  },
  "dependencies": {
    "@k8slens/cli-contracts": "^1.0.2",
    "@k8slens/cluster-contracts": "^2.2.0",
    "@k8slens/drop-down-menu-contracts": "^2.2.2",
    "@k8slens/drop-down-menu-items": "^1.1.3",
    "@k8slens/element-components": "^3.9.0",
    "@k8slens/feature-core": "^7.5.2",
    "@k8slens/icon": "^4.0.0",
    "@k8slens/injectable": "^26.2.1",
    "@k8slens/input-components": "^1.0.1",
    "@k8slens/kubernetes-contracts": "^2.0.2",
    "@k8slens/main-view-contracts": "^1.3.2",
    "@k8slens/navigation-contracts": "^1.0.0",
    "@k8slens/navigator-components": "^1.0.3",
    "@k8slens/navigator-contracts": "^2.0.2",
    "@k8slens/persistable-contracts": "^1.0.2",
    "@k8slens/stylesheet-contracts": "^1.0.0",
    "@k8slens/subscribable": "^1.1.3",
    "@k8slens/tab-contracts": "^1.2.0",
    "@k8slens/tabs-components": "^1.0.1",
    "@k8slens/use-inject": "^1.0.2",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@k8slens/package-build": "^3.0.0",
    "@k8slens/typescript": "^8.0.0",
    "@types/react": "^19.2.0",
    "rimraf": "^4.4.1"
  }
}
